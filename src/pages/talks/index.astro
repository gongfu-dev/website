---
import BaseLayout from '../../layouts/BaseLayout.astro';

import ContactCTA from '../../components/ContactCTA.astro';
import Hero from '../../components/Hero.astro';
import Grid from '../../components/Grid.astro';
import TalkCard from '../../components/TalkCard.astro';

import { talks } from '../../data/talks';
---

<BaseLayout title="Talks | Gōng-fu DEV" description="Public talks given by members of Gōng-fu DEV">
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Talks"
				tagline="Public presentations we gave about our hack sessions and community of practice."
				align="start"
			/>
			<Grid>
				{
					talks.map((talk) => (
						<li>
							<TalkCard talk={talk} />
						</li>
					))
				}
			</Grid>

			<ContactCTA />
		</main>
	</div>
</BaseLayout>
